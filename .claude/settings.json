{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet build)",
      "Bash(dotnet build *)",
      "Bash(dotnet restore)",
      "Bash(dotnet ef migrations list *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(./**/secrets.json)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
