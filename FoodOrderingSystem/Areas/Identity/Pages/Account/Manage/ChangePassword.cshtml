@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="rr-acct-card">
    <h2>Password</h2>
    <p class="rr-acct-lead">Choose a password you don't use anywhere else.</p>

    <partial name="_StatusMessage" for="StatusMessage" />

    <form id="change-password-form" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="form-floating mb-3">
            <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Current password" />
            <label asp-for="Input.OldPassword"></label>
            <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
        </div>

        <div class="row g-3 mb-2">
            <div class="col-sm-6">
                <div class="form-floating">
                    <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" aria-describedby="password-rules password-strength" placeholder="New password" />
                    <label asp-for="Input.NewPassword"></label>
                </div>
                @* Strength meter, filled in by the script below as the user types *@
                <div class="rr-strength" aria-hidden="true"><div class="rr-strength-bar" id="password-strength-bar"></div></div>
                <span class="rr-strength-label" id="password-strength" aria-live="polite"></span>
                <span asp-validation-for="Input.NewPassword" class="text-danger small d-block"></span>
            </div>
            <div class="col-sm-6">
                <div class="form-floating">
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirm new password" />
                    <label asp-for="Input.ConfirmPassword"></label>
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>
        </div>

        @* Mirrors the password options in Program.cs, so people know the rules before they submit *@
        <p id="password-rules" class="rr-acct-hint mb-3">
            At least 8 characters, with an uppercase letter, a lowercase letter, a number and a symbol.
        </p>

        <div class="rr-acct-actions">
            <button type="submit" class="btn btn-primary">Update password</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Password strength: one point per rule from Program.cs that the new password meets (5 rules).
        // Only a hint for the user - the server still checks the real rules when the form is posted.
        (function () {
            const input = document.getElementById('Input_NewPassword');
            const bar = document.getElementById('password-strength-bar');
            const label = document.getElementById('password-strength');
            const levels = [
                { text: '', colour: 'transparent' },
                { text: 'Weak', colour: '#B42318' },
                { text: 'Weak', colour: '#B42318' },
                { text: 'Fair', colour: '#B54708' },
                { text: 'Good', colour: '#3B7A57' },
                { text: 'Strong', colour: '#1F6B45' }
            ];

            input.addEventListener('input', function () {
                const value = input.value;
                const score = value.length === 0 ? 0 : [
                    value.length >= 8,
                    /[A-Z]/.test(value),
                    /[a-z]/.test(value),
                    /[0-9]/.test(value),
                    /[^A-Za-z0-9]/.test(value)
                ].filter(Boolean).length;

                bar.style.width = (score * 20) + '%';
                bar.style.backgroundColor = levels[score].colour;
                label.textContent = levels[score].text;
            });
        })();
    </script>
}
