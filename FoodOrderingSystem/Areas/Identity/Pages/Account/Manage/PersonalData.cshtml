@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Privacy and data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="rr-acct-card">
    <h2>Privacy and data</h2>
    <p class="rr-acct-lead">Your account holds the details you gave us. You can download a copy at any time.</p>

    <form id="download-data" asp-page="DownloadPersonalData" method="post">
        <button class="btn btn-outline-secondary" type="submit">Download my data</button>
    </form>

    @* Kept apart and in red: deleting cannot be undone *@
    <div class="rr-acct-danger">
        <h3 class="h6 mb-1">Delete account</h3>
        <p class="rr-acct-hint">This permanently removes your account. It can't be recovered.</p>
        <a id="delete" asp-page="DeletePersonalData" class="btn btn-outline-danger">Delete account</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
