@*
    Section menu for account settings. Only the sections this system uses:
    two-factor authentication and external logins are left out of the menu (not part of RROMS);
    their template pages still exist, so nothing links to a missing page.
*@
<nav class="rr-acct-nav" aria-label="Account sections">
    <a class="@ManageNavPages.IndexNavClass(ViewContext)" id="profile" asp-page="./Index">Profile</a>
    <a class="@ManageNavPages.EmailNavClass(ViewContext)" id="email" asp-page="./Email">Email</a>
    <a class="@ManageNavPages.ChangePasswordNavClass(ViewContext)" id="change-password" asp-page="./ChangePassword">Password</a>
    <a class="@ManageNavPages.PersonalDataNavClass(ViewContext)" id="personal-data" asp-page="./PersonalData">Privacy and data</a>
</nav>
