@page
@model EmailModel
@{
    ViewData["Title"] = "Email";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<div class="rr-acct-card">
    <h2>Email</h2>
    <p class="rr-acct-lead">This is where your booking and order updates are sent.</p>

    <partial name="_StatusMessage" for="StatusMessage" />

    <form id="email-form" method="post">
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

        <div class="form-floating mb-1">
            <input asp-for="Email" class="form-control" placeholder="Current email" disabled />
            <label asp-for="Email">Current email</label>
        </div>
        @if (Model.IsEmailConfirmed)
        {
            <p class="rr-acct-hint mb-3">Verified</p>
        }
        else
        {
            <p class="rr-acct-hint mb-3">
                Not verified yet.
                <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-link btn-sm p-0 align-baseline">Send verification email</button>
            </p>
        }

        <div class="form-floating mb-3">
            <input asp-for="Input.NewEmail" class="form-control" autocomplete="email" aria-required="true" placeholder="New email" />
            <label asp-for="Input.NewEmail"></label>
            <span asp-validation-for="Input.NewEmail" class="text-danger small"></span>
        </div>

        <div class="rr-acct-actions">
            <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="btn btn-primary">Change email</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
