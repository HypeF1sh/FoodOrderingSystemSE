@page
@model FoodOrderingSystem.Pages.Admin.Reports.CustomerActivityModel
@{
    ViewData["Title"] = "Customer Activity";
    var fromText = Model.From?.ToString("yyyy-MM-dd");
    var toText = Model.To?.ToString("yyyy-MM-dd");
    var totalReservations = Model.Customers.Sum(c => c.ReservationCount);
    var totalOrders = Model.Customers.Sum(c => c.OrderCount);
    var totalSpent = Model.Customers.Sum(c => c.TotalSpent);
}

<link rel="stylesheet" href="~/css/report-print.css" media="print" asp-append-version="true" />

<div class="container py-4 print-area">
   <h1 class="mb-1 d-print-none">Customer Activity</h1>
   <p class="text-muted mb-3 d-print-none">How active each customer was in the chosen period.</p>

    <div class="print-header d-none d-print-block">
       <h1 class="print-title">Customer activity report</h1>
       <div class="print-meta">
           Period: @Model.From?.ToString("dd MMM yyyy") &ndash; @Model.To?.ToString("dd MMM yyyy")
           &middot; Printed @DateTime.Now.ToString("dd MMM yyyy HH:mm")
       </div>
    </div>

    <div class="print-summary d-none d-print-flex">
        <div class="print-summary-item">
            <div class="print-summary-label">Customers</div>
            <div class="print-summary-value">@Model.Customers.Count</div>
        </div>
        <div class="print-summary-item">
            <div class="print-summary-label">Reservations</div>
            <div class="print-summary-value">@totalReservations</div>
        </div>
        <div class="print-summary-item">
            <div class="print-summary-label">Orders</div>
            <div class="print-summary-value">@totalOrders</div>
        </div>
        <div class="print-summary-item">
            <div class="print-summary-label">Total spent</div>
            <div class="print-summary-value">RM @totalSpent.ToString("N2")</div>
        </div>
    </div>

    <form method="get" class="row g-2 align-items-end mb-3 no-print">
        <div class="col-6 col-md-3">
            <label class="form-label" for="From">From</label>
            <input type="date" id="From" name="From" value="@fromText" class="form-control" />
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label" for="To">To</label>
            <input type="date" id="To" name="To" value="@toText" class="form-control" />
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label" for="Sort">Sort by</label>
            <select id="Sort" name="Sort" asp-items="Model.SortOptions" class="form-select"></select>
        </div>
        <div class="col-6 col-md-3">
            <button type="submit" class="btn btn-primary">Apply</button>
            <a asp-page="CustomerActivity" class="btn btn-outline-secondary">Reset</a>
        </div>
    </form>

    <div class="mb-3 no-print">
        <a asp-page="CustomerActivity" asp-page-handler="Export"
           asp-route-From="@fromText" asp-route-To="@toText" asp-route-Sort="@Model.Sort"
           class="btn btn-outline-success">Export CSV</a>
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()">Print / Save as PDF</button>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Customer</th>
                    <th class="text-end">Reservations</th>
                    <th class="text-end">Orders</th>
                    <th class="text-end">Total spent</th>
                    <th>Last visit</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var c in Model.Customers)
            {
                <tr>
                    <td>
                        @c.CustomerName
                        @if (!string.IsNullOrWhiteSpace(c.CustomerEmail))
                        {
                            <div class="small text-muted">@c.CustomerEmail</div>
                        }
                    </td>
                    <td class="text-end">@c.ReservationCount</td>
                    <td class="text-end">@c.OrderCount</td>
                    <td class="text-end">RM @c.TotalSpent.ToString("N2")</td>
                    <td>@(c.LastVisit?.ToString("dd MMM yyyy") ?? "-")</td>
                </tr>
            }
            @if (!Model.Customers.Any())
            {
                <tr><td colspan="5" class="text-muted text-center">No customer activity in this period.</td></tr>
            }
            </tbody>
        </table>
    </div>

    <p class="small text-muted mb-0">
        Reservations and orders do not include cancelled ones. Total spent is the sum of Paid payments
        (refunded and failed payments are left out). Last visit is the latest completed reservation or
        paid payment in the period.
    </p>
</div>
