@page "{id?}"
@model FoodOrderingSystem.Pages.Admin.Users.EditModel
@{
    ViewData["Title"] = "Edit User";
}

<h1>Edit User</h1>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">@Model.TargetUser?.FullName</h5>
                <p class="card-text text-muted mb-0">@Model.TargetUser?.Email</p>
            </div>
        </div>

        @if (Model.IsEditingSelf)
        {
            <div class="alert alert-info">
                This is your own account. You cannot demote or deactivate yourself.
            </div>
        }

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Input.Id" />

            <div class="mb-3">
                <label asp-for="Input.Role" class="form-label">Role</label>
                <select asp-for="Input.Role" asp-items="Model.RoleOptions" class="form-select"></select>
                <span asp-validation-for="Input.Role" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="Input.IsActive" class="form-check-input" />
                <label asp-for="Input.IsActive" class="form-check-label">Account is active</label>
            </div>

            <button type="submit" class="btn btn-primary">Save changes</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
