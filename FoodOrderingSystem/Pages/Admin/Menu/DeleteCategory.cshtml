@page "{id:int}"
@model FoodOrderingSystem.Pages.Admin.Menu.DeleteCategoryModel
@{
    ViewData["Title"] = "Delete Category";
    var category = Model.Category!; // ! is safe: OnGet/OnPost return NotFound before rendering when Category is null
}

<div class="container mt-4">
    <h1>Delete Category</h1>

    <div class="row">
        <div class="col-lg-6">
            <div class="card shadow">
                <div class="card-header bg-danger text-white">Are you sure you want to delete this category?</div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <dl>
                        <dt>Name</dt>
                        <dd>@category.Name</dd>
                        <dt>Description</dt>
                        <dd>@(string.IsNullOrEmpty(category.Description) ? "—" : category.Description)</dd>
                        <dt>Items in this category</dt>
                        <dd class="mb-0">@category.ItemCount</dd>
                    </dl>

                    @if (Model.BlockReason != null)
                    {
                        <div class="alert alert-warning">@Model.BlockReason</div>
                    }

                    <form method="post">
                        <button type="submit" class="btn btn-danger" disabled="@(Model.BlockReason != null)">Delete</button>
                        <a asp-page="./Index" asp-route-tab="categories" class="btn btn-secondary">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
