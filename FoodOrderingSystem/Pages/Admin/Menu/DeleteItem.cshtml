@page "{id:int}"
@model FoodOrderingSystem.Pages.Admin.Menu.DeleteItemModel
@{
    ViewData["Title"] = "Delete Menu Item";
    var item = Model.Item!; // ! is safe: OnGet/OnPost return NotFound before rendering when Item is null
}

<div class="container mt-4">
    <h1>Delete Menu Item</h1>

    <div class="row">
        <div class="col-lg-6">
            <div class="card shadow">
                <div class="card-header bg-danger text-white">Are you sure you want to delete this item?</div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="d-flex gap-3 mb-3">
                        <img src="@item.ImageUrl" alt="" class="delete-item-img" />
                        <dl class="mb-0">
                            <dt>Name</dt>
                            <dd>@item.Name</dd>
                            <dt>Category</dt>
                            <dd>@item.CategoryName</dd>
                            <dt>Price</dt>
                            <dd class="mb-0">RM @item.Price.ToString("0.00")</dd>
                        </dl>
                    </div>

                    @if (Model.BlockReason != null)
                    {
                        <div class="alert alert-warning">@Model.BlockReason</div>
                    }

                    <form method="post">
                        <button type="submit" class="btn btn-danger" disabled="@(Model.BlockReason != null)">Delete</button>
                        <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
