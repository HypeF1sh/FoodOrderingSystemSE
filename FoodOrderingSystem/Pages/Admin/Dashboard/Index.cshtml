@page
@using FoodOrderingSystem.Services
@using FoodOrderingSystem.ViewModels
@model FoodOrderingSystem.Pages.Admin.Dashboard.IndexModel
@{
    ViewData["Title"] = "Dashboard";
    var today = Model.Today;
    var dashboard = Model.Dashboard;

    // Quick ranges: label, from, to. All end today.
    var quickRanges = new (string Label, DateOnly From, DateOnly To)[]
    {
        ("Today", today, today),
        ("Last 7 days", today.AddDays(-6), today),
        ("Last 30 days", today.AddDays(-29), today),
        ("This month", new DateOnly(today.Year, today.Month, 1), today),
        ("This year", new DateOnly(today.Year, 1, 1), today)
    };

    // "View all" links open Monitoring with the same dates. Monitoring allows at most
    // AdminMonitoringService.MaxRangeDays, so a longer range opens its most recent part.
    var monitorTo = Model.SelectedTo;
    var monitorFrom = Model.SelectedFrom;
    if (monitorTo.DayNumber - monitorFrom.DayNumber + 1 > AdminMonitoringService.MaxRangeDays)
    {
        monitorFrom = monitorTo.AddDays(1 - AdminMonitoringService.MaxRangeDays);
    }
    var monitorFromText = monitorFrom.ToString("yyyy-MM-dd");
    var monitorToText = monitorTo.ToString("yyyy-MM-dd");
}

<div class="container mt-4">
    <div class="mb-3">
        <h1 class="mb-1">Dashboard</h1>
        <p class="text-muted mb-0">Sales, bookings and popular dishes for the dates you choose.</p>
    </div>

    <!-- Filter bar: a GET form, so the chosen range is in the URL and can be bookmarked.
         admin-dashboard.js submits it as soon as a date or the grouping changes. -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="rr-quick-ranges d-flex flex-wrap gap-2 mb-3">
                @foreach (var range in quickRanges)
                {
                    var isActive = range.From == Model.SelectedFrom && range.To == Model.SelectedTo;
                    <a class="btn btn-sm rr-range @(isActive ? "active" : "")"
                       asp-page="./Index"
                       asp-route-from="@range.From.ToString("yyyy-MM-dd")"
                       asp-route-to="@range.To.ToString("yyyy-MM-dd")">@range.Label</a>
                }
            </div>

            <form method="get" asp-page="./Index" id="dashboardFilter" class="row g-2 align-items-end">
                <div asp-validation-summary="ModelOnly" class="text-danger col-12"></div>
                <div class="col-6 col-md-4">
                    <label for="from" class="form-label">From</label>
                    <input id="from" type="date" name="from" value="@Model.SelectedFrom.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="col-6 col-md-4">
                    <label for="to" class="form-label">To</label>
                    <input id="to" type="date" name="to" value="@Model.SelectedTo.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="col-12 col-md-4">
                    <label for="grouping" class="form-label">Group by</label>
                    <select id="grouping" name="grouping" class="form-select">
                        @foreach (var grouping in Enum.GetValues<ReportGrouping>())
                        {
                            <option value="@grouping" selected="@(dashboard?.Grouping == grouping)">@grouping</option>
                        }
                    </select>
                </div>
                <!-- Only needed when JavaScript is off; otherwise the form submits on change -->
                <noscript>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">Show report</button>
                    </div>
                </noscript>
            </form>
        </div>
    </div>

    @if (dashboard != null)
    {
        <!-- Headline numbers -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-xl-3">
                <div class="card h-100 rr-stat">
                    <div class="card-body">
                        <div class="rr-stat-label">Revenue</div>
                        <div class="rr-stat-value">RM @dashboard.Revenue.ToString("0.00")</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-xl-3">
                <div class="card h-100 rr-stat">
                    <div class="card-body">
                        <div class="rr-stat-label">Average order</div>
                        <div class="rr-stat-value">RM @dashboard.AverageOrderValue.ToString("0.00")</div>
                        <div class="rr-stat-note">Across @dashboard.PaidOrderCount paid @(dashboard.PaidOrderCount == 1 ? "order" : "orders")</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-xl-3">
                <div class="card h-100 rr-stat">
                    <div class="card-body">
                        <div class="rr-stat-label">Orders</div>
                        <div class="rr-stat-value">@dashboard.OrderCount</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-xl-3">
                <div class="card h-100 rr-stat">
                    <div class="card-body">
                        <div class="rr-stat-label">Bookings</div>
                        <div class="rr-stat-value">@dashboard.BookingCount</div>
                        <div class="rr-stat-note">@dashboard.CoverCount @(dashboard.CoverCount == 1 ? "guest" : "guests")</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <!-- Sales chart; the full list of paid payments lives on Monitoring -->
            <div class="col-12 col-xl-8">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <h2 class="h5 mb-3">Sales (RM)</h2>
                        <div class="rr-chart">
                            <canvas id="salesChart" role="img" aria-label="Bar chart of sales per @dashboard.Grouping.ToString().ToLower()"></canvas>
                        </div>
                        <a asp-page="/Admin/Monitoring/Index" asp-route-tab="payments" asp-route-Status="Paid"
                           asp-route-From="@monitorFromText" asp-route-To="@monitorToText"
                           class="align-self-start mt-3 fw-semibold text-decoration-none">View all sales &rarr;</a>
                    </div>
                </div>
            </div>

            <!-- Popular dishes -->
            <div class="col-12 col-xl-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="h5 mb-3">Popular dishes</h2>
                        @if (dashboard.PopularItems.Count == 0)
                        {
                            <p class="text-muted mb-0">No orders in this range.</p>
                        }
                        else
                        {
                            <div class="rr-chart">
                                <canvas id="dishesChart" role="img" aria-label="Bar chart of the most ordered dishes"></canvas>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Bookings chart; the full reservation list lives on Monitoring -->
        <div class="card mb-4">
            <div class="card-body d-flex flex-column">
                <h2 class="h5 mb-3">Bookings</h2>
                <div class="rr-chart">
                    <canvas id="bookingsChart" role="img" aria-label="Bar chart of bookings per @dashboard.Grouping.ToString().ToLower()"></canvas>
                </div>
                <a asp-page="/Admin/Monitoring/Index" asp-route-tab="reservations"
                   asp-route-From="@monitorFromText" asp-route-To="@monitorToText"
                   class="align-self-start mt-3 fw-semibold text-decoration-none">View all bookings &rarr;</a>
            </div>
        </div>

        <!-- Chart data for admin-dashboard.js -->
        <script type="application/json" id="dashboardData">@Html.Raw(Model.ChartDataJson)</script>
    }
</div>

@section Scripts {
    @if (dashboard != null)
    {
        <script src="~/lib/chart.js/chart.umd.min.js"></script>
    }
    @* Always loaded: it also submits the filter form on change, which is needed even when the range is invalid *@
    <script src="~/js/admin-dashboard.js" asp-append-version="true"></script>
}
