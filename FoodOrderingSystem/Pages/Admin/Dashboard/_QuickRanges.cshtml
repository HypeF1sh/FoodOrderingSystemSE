@model (DateOnly Today, DateOnly From, DateOnly To)
@*
    Quick date-range buttons shared by the Dashboard and Dish sales reports (PB22).
    Each one links back to the current page with that range, and the range on screen is highlighted.
*@
@{
    var today = Model.Today;

    // Label, from, to. All end today.
    var quickRanges = new (string Label, DateOnly From, DateOnly To)[]
    {
        ("Today", today, today),
        ("Last 7 days", today.AddDays(-6), today),
        ("Last 30 days", today.AddDays(-29), today),
        ("This month", new DateOnly(today.Year, today.Month, 1), today),
        ("This year", new DateOnly(today.Year, 1, 1), today)
    };
}
<div class="d-flex flex-wrap gap-2 mb-3">
    @foreach (var range in quickRanges)
    {
        var isActive = range.From == Model.From && range.To == Model.To;
        @* Url.Page(null, ...) means "this same page", so the partial works on either report *@
        <a class="btn btn-sm rr-range @(isActive ? "active" : "")"
           aria-current="@(isActive ? "true" : null)"
           href="@Url.Page(null, new { from = range.From.ToString("yyyy-MM-dd"), to = range.To.ToString("yyyy-MM-dd") })">@range.Label</a>
    }
</div>
