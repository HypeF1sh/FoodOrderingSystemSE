@using FoodOrderingSystem.ViewModels
@model (string LabelHeader, string ValueHeader, List<ReportPointViewModel> Points, bool IsMoney)

@* The table version of a dashboard chart: for screen readers, printing, and if the chart script fails *@
<div class="table-responsive mt-2">
    <table class="table table-hover table-bordered table-sm mb-0">
        <thead>
            <tr>
                <th>@Model.LabelHeader</th>
                <th class="text-end">@Model.ValueHeader</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var point in Model.Points)
            {
                <tr>
                    <td>@point.Label</td>
                    <td class="text-end">@(Model.IsMoney ? point.Value.ToString("0.00") : point.Value.ToString("0"))</td>
                </tr>
            }
        </tbody>
    </table>
</div>
