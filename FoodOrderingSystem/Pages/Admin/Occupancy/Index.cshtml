@page
@using FoodOrderingSystem.ViewModels
@model FoodOrderingSystem.Pages.Admin.Occupancy.IndexModel
@{
    ViewData["Title"] = "Table Occupancy Analytics";
    var report = Model.Report;
}

<style>
    .rr-stat-label {
        color: var(--rr-muted, #6c757d);
        font-size: 0.875rem;
    }
    .rr-stat-value {
        font-family: var(--rr-serif, Georgia, serif);
        font-size: 1.65rem;
        font-weight: 600;
        line-height: 1.2;
        margin: 0.25rem 0;
    }
    .rr-stat-note {
        color: var(--rr-muted, #6c757d);
        font-size: 0.825rem;
    }
    .rr-chart-box {
        position: relative;
        height: 300px;
    }
    .rr-heatmap-cell {
        text-align: center;
        font-weight: 600;
        font-size: 0.85rem;
        min-width: 54px;
        transition: background-color 0.15s ease;
    }
</style>

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h1 class="mb-1">Table Occupancy Analytics</h1>
            <p class="text-muted mb-0">
                Peak dining hours, table utilisation percentages (90-minute slots) and booking trends. Cancelled and No-Show bookings are excluded.
            </p>
        </div>
        <a asp-page="/Admin/Index" class="btn btn-outline-secondary">Back to Configurations</a>
    </div>

    <!-- Filter Bar (Matches Dashboard date range & max 366 days validation) -->
    <div class="card mb-4">
        <div class="card-body">
            <!-- Quick Range Presets -->
            <div class="d-flex flex-wrap gap-2 mb-3">
                <a asp-page="./Index"
                   asp-route-from="@Model.Today.ToString("yyyy-MM-dd")"
                   asp-route-to="@Model.Today.ToString("yyyy-MM-dd")"
                   class="btn btn-sm btn-outline-secondary">Today</a>
                <a asp-page="./Index"
                   asp-route-from="@Model.Today.AddDays(-6).ToString("yyyy-MM-dd")"
                   asp-route-to="@Model.Today.ToString("yyyy-MM-dd")"
                   class="btn btn-sm btn-outline-secondary">Last 7 days</a>
                <a asp-page="./Index"
                   asp-route-from="@Model.Today.AddDays(-29).ToString("yyyy-MM-dd")"
                   asp-route-to="@Model.Today.ToString("yyyy-MM-dd")"
                   class="btn btn-sm btn-outline-secondary">Last 30 days</a>
                <a asp-page="./Index"
                   asp-route-from="@(new DateOnly(Model.Today.Year, Model.Today.Month, 1).ToString("yyyy-MM-dd"))"
                   asp-route-to="@Model.Today.ToString("yyyy-MM-dd")"
                   class="btn btn-sm btn-outline-secondary">This month</a>
            </div>

            <form method="get" asp-page="./Index" id="occupancyFilterForm" class="row g-2 align-items-end">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger col-12 mb-2"></div>

                <div class="col-6 col-md-3">
                    <label for="from" class="form-label">From</label>
                    <input id="from" type="date" name="from" value="@Model.SelectedFrom.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="col-6 col-md-3">
                    <label for="to" class="form-label">To</label>
                    <input id="to" type="date" name="to" value="@Model.SelectedTo.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="col-8 col-md-3">
                    <label for="grouping" class="form-label">Trend grouping</label>
                    <select id="grouping" name="grouping" class="form-select">
                        @foreach (var g in Enum.GetValues<OccupancyGrouping>())
                        {
                            <option value="@g" selected="@(report?.Grouping == g)">@g</option>
                        }
                    </select>
                </div>
                <div class="col-4 col-md-3 d-grid">
                    <button type="submit" class="btn btn-primary">Apply Filter</button>
                </div>
            </form>
        </div>
    </div>

    @if (report != null)
    {
        <!-- Headline Summary Cards -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-xl-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="rr-stat-label">Active Bookings</div>
                        <div class="rr-stat-value">@report.TotalBookings</div>
                        <div class="rr-stat-note">@report.TotalGuests total @(report.TotalGuests == 1 ? "guest" : "guests") (avg @report.AveragePartySize.ToString("0.0")/party)</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-xl-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="rr-stat-label">Overall Table Utilisation</div>
                        <div class="rr-stat-value">@report.OverallUtilizationPercent.ToString("0.0")%</div>
                        <div class="rr-stat-note">Across @report.TotalDays @(report.TotalDays == 1 ? "day" : "days") (90-min slots)</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-xl-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="rr-stat-label">Peak Dining Window</div>
                        <div class="rr-stat-value fs-5">@report.PeakHourLabel</div>
                        <div class="rr-stat-note">Busiest day: @report.PeakDayLabel</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-xl-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="rr-stat-label">Busiest &amp; Quietest Tables</div>
                        <div class="rr-stat-value fs-5">@report.BusiestTableLabel</div>
                        <div class="rr-stat-note">Quietest: @report.QuietestTableLabel</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- SECTION 1: Peak Hours (Bar Chart + Day of Week x Hour Heatmap Table) -->
        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-1">1. Peak Hours Analysis</h2>
                <p class="text-muted small mb-3">
                    Bookings and guest volume by seating start hour, followed by a Day-of-Week &times; Hour heatmap table.
                </p>

                <div class="rr-chart-box mb-4">
                    <canvas id="peakHoursChart" role="img" aria-label="Bar chart of bookings by hour of day"></canvas>
                </div>

                <h3 class="h6 mb-2">Day of Week &times; Hour Heatmap (Bookings Count)</h3>
                <div class="table-responsive">
                    <table class="table table-bordered table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Day of Week</th>
                                @for (int hr = report.EarliestHour; hr <= report.LatestHour; hr++)
                                {
                                    <th class="text-center small">@(new TimeOnly(hr, 0).ToString("htt").ToLower())</th>
                                }
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in report.HeatmapRows)
                        {
                            <tr>
                                <td class="fw-semibold">@row.DayName</td>
                                @for (int hr = report.EarliestHour; hr <= report.LatestHour; hr++)
                                {
                                    int count = row.BookingsByHour.GetValueOrDefault(hr, 0);
                                    double alpha = report.MaxHeatmapCellCount > 0
                                        ? Math.Round((double)count / report.MaxHeatmapCellCount * 0.75, 2)
                                        : 0;
                                    string bgStyle = count > 0
                                        ? $"background-color: rgba(139, 38, 53, {alpha.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)}); color: {(alpha > 0.45 ? "#fff" : "#212529")};"
                                        : "color: #adb5bd;";

                                    <td class="rr-heatmap-cell" style="@bgStyle">@count</td>
                                }
                                <td class="text-end fw-bold">@row.TotalBookings</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- SECTION 2: Table Utilisation % (Chart + Table beneath) -->
        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-1">2. Table Utilisation (%)</h2>
                <p class="text-muted small mb-3">
                    Calculated as <code>Booked Minutes (Bookings &times; 90 mins) &divide; Open Minutes</code> per table over the selected date range, sorted from busiest to quietest.
                </p>

                <div class="rr-chart-box mb-4">
                    <canvas id="tableUtilChart" role="img" aria-label="Bar chart of table utilisation percentage"></canvas>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Rank</th>
                                <th>Table</th>
                                <th>Dining Area</th>
                                <th class="text-center">Capacity</th>
                                <th class="text-end">Bookings</th>
                                <th class="text-end">Guests Seated</th>
                                <th class="text-end">Booked Mins</th>
                                <th class="text-end">Open Mins</th>
                                <th class="text-end">Utilisation %</th>
                            </tr>
                        </thead>
                        <tbody>
                        @{
                            int rank = 1;
                        }
                        @foreach (var t in report.TableUtilizations)
                        {
                            var badgeClass = t.UtilizationPercent >= 50 ? "bg-success"
                                : t.UtilizationPercent >= 20 ? "bg-primary"
                                : t.BookingCount > 0 ? "bg-warning text-dark"
                                : "bg-secondary";

                            <tr>
                                <td>#@rank</td>
                                <td class="fw-semibold">
                                    Table @t.TableNumber
                                    @if (!t.IsActive)
                                    {
                                        <span class="badge bg-secondary ms-1">Inactive</span>
                                    }
                                </td>
                                <td>@t.DiningAreaName</td>
                                <td class="text-center">@t.Capacity</td>
                                <td class="text-end">@t.BookingCount</td>
                                <td class="text-end">@t.GuestCount</td>
                                <td class="text-end">@t.BookedMinutes.ToString("N0")</td>
                                <td class="text-end">@t.OpenMinutes.ToString("N0")</td>
                                <td class="text-end">
                                    <span class="badge @badgeClass">@t.UtilizationPercent.ToString("0.0")%</span>
                                </td>
                            </tr>
                            rank++;
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- SECTION 3: Bookings & Guests Trend (Chart + Table beneath) -->
        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-1">3. Bookings &amp; Guests Trend (Grouped by @report.Grouping)</h2>
                <p class="text-muted small mb-3">
                    Progression of confirmed/completed reservations and total guests seated across the selected period.
                </p>

                <div class="rr-chart-box mb-4">
                    <canvas id="trendChart" role="img" aria-label="Trend chart of bookings and guests over time"></canvas>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Period</th>
                                <th>Date Range</th>
                                <th class="text-end">Bookings</th>
                                <th class="text-end">Guests (Covers)</th>
                                <th class="text-end">Avg Party Size</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var pt in report.TrendPoints)
                        {
                            double avg = pt.BookingCount > 0 ? Math.Round((double)pt.GuestCount / pt.BookingCount, 1) : 0;
                            <tr>
                                <td class="fw-semibold">@pt.Label</td>
                                <td class="text-muted small">
                                    @(pt.PeriodStart == pt.PeriodEnd
                                        ? pt.PeriodStart.ToString("dd/MM/yyyy")
                                        : $"{pt.PeriodStart:dd/MM/yyyy} – {pt.PeriodEnd:dd/MM/yyyy}")
                                </td>
                                <td class="text-end">@pt.BookingCount</td>
                                <td class="text-end">@pt.GuestCount</td>
                                <td class="text-end">@(pt.BookingCount > 0 ? avg.ToString("0.0") : "-")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <script type="application/json" id="occupancyChartData">@Html.Raw(Model.ChartDataJson)</script>
    }
</div>

@section Scripts {
    @if (report != null)
    {
        <script src="~/lib/chart.js/chart.umd.min.js"></script>
        <script>
            (function () {
                const dataEl = document.getElementById('occupancyChartData');
                if (!dataEl || typeof Chart === 'undefined') return;

                const data = JSON.parse(dataEl.textContent || '{}');
                const primaryColor = 'rgba(139, 38, 53, 0.82)';
                const secondaryColor = 'rgba(201, 148, 58, 0.78)';

                // 1. Peak Hours Chart
                const peakCtx = document.getElementById('peakHoursChart');
                if (peakCtx && data.peakHours) {
                    new Chart(peakCtx, {
                        type: 'bar',
                        data: {
                            labels: data.peakHours.labels,
                            datasets: [
                                {
                                    label: 'Bookings',
                                    data: data.peakHours.bookings,
                                    backgroundColor: primaryColor,
                                    borderRadius: 4
                                },
                                {
                                    label: 'Guests',
                                    data: data.peakHours.guests,
                                    backgroundColor: secondaryColor,
                                    borderRadius: 4
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            scales: {
                                y: { beginAtZero: true, ticks: { precision: 0 } }
                            }
                        }
                    });
                }

                // 2. Table Utilisation % Chart
                const tableCtx = document.getElementById('tableUtilChart');
                if (tableCtx && data.tables) {
                    new Chart(tableCtx, {
                        type: 'bar',
                        data: {
                            labels: data.tables.labels,
                            datasets: [
                                {
                                    label: 'Utilisation (%)',
                                    data: data.tables.utilization,
                                    backgroundColor: primaryColor,
                                    borderRadius: 4
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    suggestedMax: 100,
                                    ticks: { callback: function (v) { return v + '%'; } }
                                }
                            }
                        }
                    });
                }

                // 3. Trend Chart
                const trendCtx = document.getElementById('trendChart');
                if (trendCtx && data.trend) {
                    new Chart(trendCtx, {
                        type: 'bar',
                        data: {
                            labels: data.trend.labels,
                            datasets: [
                                {
                                    label: 'Bookings',
                                    data: data.trend.bookings,
                                    backgroundColor: primaryColor,
                                    borderRadius: 4
                                },
                                {
                                    type: 'line',
                                    label: 'Guests Seated',
                                    data: data.trend.guests,
                                    borderColor: secondaryColor,
                                    backgroundColor: secondaryColor,
                                    tension: 0.25,
                                    borderWidth: 2
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            scales: {
                                y: { beginAtZero: true, ticks: { precision: 0 } }
                            }
                        }
                    });
                }
            })();
        </script>
    }
}