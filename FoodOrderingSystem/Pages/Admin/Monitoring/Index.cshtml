@page
@model FoodOrderingSystem.Pages.Admin.Monitoring.IndexModel
@{
    ViewData["Title"] = "Monitoring";

    string BadgeClass(string status) => status switch
    {
        "Pending" => "bg-warning text-dark",
        "Confirmed" => "bg-primary",
        "Completed" => "bg-success",
        "Cancelled" => "bg-secondary",
        "NoShow" => "bg-danger",
        _ => "bg-dark"
    };

    var fromText = Model.From?.ToString("yyyy-MM-dd");
    var toText = Model.To?.ToString("yyyy-MM-dd");
}

<div class="container py-4">
    <h1 class="mb-1">Monitoring</h1>
    <p class="text-muted mb-3">Read-only view of reservations, orders and payments.</p>

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <a class="nav-link @(Model.Tab == "reservations" ? "active" : "")"
               asp-page="Index" asp-route-tab="reservations" asp-route-From="@fromText" asp-route-To="@toText">Reservations</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.Tab == "orders" ? "active" : "")"
               asp-page="Index" asp-route-tab="orders" asp-route-From="@fromText" asp-route-To="@toText">Orders</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.Tab == "payments" ? "active" : "")"
               asp-page="Index" asp-route-tab="payments" asp-route-From="@fromText" asp-route-To="@toText">Payments</a>
        </li>
    </ul>

    <form method="get" class="row g-2 align-items-end mb-3">
        <input type="hidden" name="Tab" value="@Model.Tab" />
        <div class="col-6 col-md-3">
            <label class="form-label" for="From">From</label>
            <input type="date" id="From" name="From" value="@fromText" class="form-control" />
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label" for="To">To</label>
            <input type="date" id="To" name="To" value="@toText" class="form-control" />
        </div>
        @if (Model.Tab == "reservations")
        {
            <div class="col-6 col-md-3">
                <label class="form-label" for="Status">Status</label>
                <select id="Status" name="Status" asp-items="Model.StatusOptions" class="form-select"></select>
            </div>
        }
        <div class="col-6 col-md-3">
            <button type="submit" class="btn btn-primary">Apply</button>
            <a asp-page="Index" asp-route-tab="@Model.Tab" class="btn btn-outline-secondary">Reset</a>
        </div>
    </form>

    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    @if (Model.Tab == "reservations")
    {
        <p class="mb-2">
            <strong>@Model.Reservations.TotalInRange</strong> reservation(s) in this range:
            @foreach (var item in Model.Reservations.StatusCounts)
            {
                <span class="badge @BadgeClass(item.Key) me-1">@item.Key: @item.Value</span>
            }
        </p>

        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Customer</th>
                        <th>Table</th>
                        <th>Party</th>
                        <th>Status</th>
                        <th>Special requests</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Reservations.Reservations)
                    {
                        <tr>
                            <td>@r.ReservationDate.ToString("dd MMM yyyy")</td>
                            <td>@r.StartTime.ToString("HH:mm") &ndash; @r.EndTime.ToString("HH:mm")</td>
                            <td>
                                @r.CustomerName
                                <div class="small text-muted">@r.CustomerEmail</div>
                            </td>
                            <td>@r.DiningAreaName &middot; @r.TableNumber</td>
                            <td>@r.PartySize</td>
                            <td><span class="badge @BadgeClass(r.Status)">@r.Status</span></td>
                            <td class="small">@(string.IsNullOrWhiteSpace(r.SpecialRequests) ? "-" : r.SpecialRequests)</td>
                        </tr>
                    }
                    @if (!Model.Reservations.Reservations.Any())
                    {
                        <tr><td colspan="7" class="text-muted text-center">No reservations match these filters.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (Model.Tab == "orders")
    {
        <div class="alert alert-info">The Orders list is coming soon. It will be added once the order list method is available.</div>
    }
    else
    {
        <div class="alert alert-info">The Payments list is coming soon. It will be added once the payment list method is available.</div>
    }
</div>
