@page
@model FoodOrderingSystem.Pages.Notifications.IndexModel
@{
    ViewData["Title"] = "Notifications";
    int unreadCount = Model.Notifications.Count(n => !n.IsRead);
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h1 class="mb-0">My Notifications</h1>
            <p class="text-muted small mb-0">
                Updates for your reservations, orders, payments, and promotions (@unreadCount unread)
            </p>
        </div>
        @if (unreadCount > 0)
        {
            <form method="post" asp-page-handler="MarkAllRead">
                <button type="submit" class="btn btn-sm btn-outline-primary">Mark All as Read</button>
            </form>
        }
    </div>

    @if (!Model.Notifications.Any())
    {
        <div class="alert alert-info">
            You do not have any notifications yet.
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-2">
            @foreach (var item in Model.Notifications)
            {
                var typeBadge = item.Type switch
                {
                    "Reservation" => "bg-primary",
                    "Order" => "bg-success",
                    "Payment" => "bg-info text-dark",
                    "Promotion" => "bg-warning text-dark",
                    _ => "bg-secondary"
                };

                <div class="card @(item.IsRead ? "opacity-75" : "border-primary")">
                    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="badge @typeBadge">@item.Type</span>
                                @if (!item.IsRead)
                                {
                                    <span class="badge bg-danger">Unread</span>
                                }
                                <span class="text-muted small">
                                    @item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy hh:mm tt")
                                </span>
                            </div>
                            <div class="@(item.IsRead ? "" : "fw-semibold")">@item.Message</div>
                        </div>

                        @if (!item.IsRead)
                        {
                            <form method="post" asp-page-handler="MarkRead">
                                <input type="hidden" name="id" value="@item.NotificationId" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Mark Read</button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>