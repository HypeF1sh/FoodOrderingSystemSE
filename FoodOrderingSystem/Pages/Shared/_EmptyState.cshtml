@model FoodOrderingSystem.ViewModels.EmptyStateViewModel
@*
    Friendly empty state for back office lists: an icon, a short title and one line saying what to do.
    Usage: <partial name="_EmptyState" model='new EmptyStateViewModel("No bookings", "Try another date.", "calendar")' />
    Icons are small inline SVGs, so there is no icon font to download (works offline).
*@
<div class="bo-empty" role="status">
    <span class="bo-empty-icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            @switch (Model.Icon)
            {
                case "receipt":
                    <path d="M6 3h12v18l-3-2-3 2-3-2-3 2z" /><path d="M9 8h6M9 12h6M9 16h3" />
                    break;
                case "star":
                    <path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" />
                    break;
                case "ticket":
                    <path d="M4 7h16v3a2 2 0 0 0 0 4v3H4v-3a2 2 0 0 0 0-4z" /><path d="M10 7v10" stroke-dasharray="2 2" />
                    break;
                case "table":
                    <path d="M3 9h18M5 9v10M19 9v10M8 9V6h8v3" />
                    break;
                default:
                    <rect x="4" y="5" width="16" height="15" rx="2" /><path d="M4 10h16M9 3v4M15 3v4" />
                    break;
            }
        </svg>
    </span>
    <p class="bo-empty-title">@Model.Title</p>
    <p class="bo-empty-text">@Model.Text</p>
</div>
