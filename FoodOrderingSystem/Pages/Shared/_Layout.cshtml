@using System.Security.Claims
@using FoodOrderingSystem.Services
@inject INotificationService NotificationService
@{
    const string RestaurantName = "Rumah Rasa";
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;

    // Staff and admins work in the back office, so the customer links are hidden for them (BUG1)
    var isAdmin = User.IsInRole("Administrator");
    var isBackOfficeUser = isAdmin || User.IsInRole("Staff");

    int unreadNotifications = 0;
    if (User.Identity?.IsAuthenticated == true)
    {
        var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (!string.IsNullOrEmpty(currentUserId))
        {
            unreadNotifications = await NotificationService.GetUnreadCountAsync(currentUserId);
        }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @RestaurantName</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FoodOrderingSystem.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="rr-header">
        <nav class="navbar navbar-expand-md">
            <div class="container">

                <a class="navbar-brand rr-wordmark" asp-page="/Index">@RestaurantName</a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#rrNav"
                        aria-controls="rrNav"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="rrNav">

                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link @(currentPage == "/Index" ? "active" : "")"
                               asp-page="/Index">Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(currentPage.StartsWith("/Menu/") ? "active" : "")"
                               asp-page="/Menu/Index">Menu</a>
                        </li>

                        @if (isBackOfficeUser)
                        {
                            @* One way in: admins land on the dashboard, staff on the Floor (same as after login) *@
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-area=""
                                   asp-page="@(isAdmin ? "/Admin/Dashboard/Index" : "/Staff/Floor/Index")">Back office</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentPage.StartsWith("/Reservations") ? "active" : "")"
                                   asp-page="/Reservations/Create">Book a table</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @(currentPage.StartsWith("/Orders") ? "active" : "")"
                                   asp-page="/Orders/Index">My orders</a>
                            </li>
                        }

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Customer"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(currentPage.StartsWith("/Feedback") ? "active" : "")"
                                       asp-page="/Feedback/Index">Feedback</a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link @(currentPage.StartsWith("/Notifications") ? "active" : "")"
                                       asp-page="/Notifications/Index">
                                        Notifications
                                        @if (unreadNotifications > 0)
                                        {
                                            <span class="badge rounded-pill bg-danger ms-1">@unreadNotifications</span>
                                        }
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <div class="rr-account">
                        <partial name="_LoginPartial" />
                    </div>

                </div>
            </div>
        </nav>
    </header>

    <main>
        <div class="container">
            <partial name="_Banners" />
        </div>

        @RenderBody()
    </main>

    <footer class="rr-footer">
        <div class="container">
            <span class="rr-footer-mark">@RestaurantName</span>
            <a asp-page="/Privacy">Privacy</a>
            <span class="rr-footer-meta">&copy; @DateTime.Now.Year</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>