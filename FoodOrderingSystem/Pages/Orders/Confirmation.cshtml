@page "{id:int}"
@using FoodOrderingSystem.Models.Enums
@model FoodOrderingSystem.Pages.Orders.ConfirmationModel
@{
    ViewData["Title"] = "Order Placed";
    var order = Model.Order!; // ! is safe: OnGetAsync returns NotFound before rendering when Order is null
}

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-7">
            <div class="card shadow">
                <div class="card-header">Order #@order.OrderId placed</div>
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted">@order.CreatedAt.ToString("dd/MM/yyyy hh:mm tt")</span>
                        <span class="d-flex gap-1">
                            <partial name="_OrderStatusBadge" model="order.Status" />
                            <partial name="/Pages/Payments/_PaymentStatusBadge.cshtml" model="Model.Payment.Status" />
                        </span>
                    </div>

                    <ul class="list-unstyled mb-3">
                        @foreach (var line in order.Lines)
                        {
                            <li class="d-flex justify-content-between gap-2 py-1 border-bottom">
                                <span>@line.Quantity × @line.Name</span>
                                <span class="text-nowrap">RM @line.LineTotal.ToString("0.00")</span>
                            </li>
                        }
                    </ul>
                    <div class="d-flex justify-content-between fw-semibold mb-3">
                        <span>Total</span>
                        <span>RM @order.TotalAmount.ToString("0.00")</span>
                    </div>

                    @if (!string.IsNullOrEmpty(order.Notes))
                    {
                        <p class="mb-3"><span class="text-muted">Notes:</span> @order.Notes</p>
                    }

                    <p class="text-muted">The kitchen has your order. You can pay at the counter or online.</p>

                    <div class="d-flex flex-wrap gap-2">
                        @if (Model.Payment.IsPaid)
                        {
                            <a asp-page="/Payments/Receipt" asp-route-paymentId="@Model.Payment.PaidPaymentId" class="btn btn-primary">View receipt</a>
                        }
                        else if (order.Status != OrderStatus.Cancelled && Model.Payment.Status != PaymentStatus.Refunded)
                        {
                            <a asp-page="/Payments/Pay" asp-route-orderId="@order.OrderId" class="btn btn-primary">Pay now</a>
                        }
                        <a asp-page="/Orders/Index" class="btn btn-secondary">My orders</a>
                        <a asp-page="/Menu/Index" class="btn btn-outline-secondary">Back to menu</a>
                    </div>
                    @if (!Model.Payment.IsPaid && order.Status != OrderStatus.Cancelled)
                    {
                        <p class="text-muted small mt-2 mb-0">Prefer cash? Pay at the counter.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
