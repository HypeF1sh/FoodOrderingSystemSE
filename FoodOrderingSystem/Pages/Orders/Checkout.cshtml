@page
@model FoodOrderingSystem.Pages.Orders.CheckoutModel
@{
    ViewData["Title"] = "Checkout";
    var cart = Model.Cart;
}

<div class="container mt-4">
    <h1>Checkout</h1>

    <div class="row">
        <div class="col-lg-7">
            <div class="card shadow">
                <div class="card-header">Your order</div>
                <div class="card-body">
                    <!-- Read-only summary: what is ordered and the price come from the cart, not this form -->
                    <ul class="list-unstyled mb-3">
                        @foreach (var line in cart.Lines)
                        {
                            <li class="d-flex justify-content-between gap-2 py-1 border-bottom">
                                <span>@line.Quantity × @line.Name</span>
                                <span class="text-nowrap">RM @line.LineTotal.ToString("0.00")</span>
                            </li>
                        }
                    </ul>
                    @if (Model.DiscountedTotal != null)
                    {
                        <div class="d-flex justify-content-between text-muted">
                            <span>Subtotal</span>
                            <span>RM @cart.Total.ToString("0.00")</span>
                        </div>
                        <div class="d-flex justify-content-between text-success">
                            <span>Promo: @Model.AppliedPromoText</span>
                            <span>&minus; RM @Model.DiscountAmount!.Value.ToString("0.00")</span>
                        </div>
                        <div class="d-flex justify-content-between fw-semibold mb-4">
                            <span>Total to pay</span>
                            <span>RM @Model.DiscountedTotal.Value.ToString("0.00")</span>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-between fw-semibold mb-4">
                            <span>Total</span>
                            <span>RM @cart.Total.ToString("0.00")</span>
                        </div>
                    }

                    @if (Model.OrderTarget.CanOrder)
                    {
                        <div class="alert alert-light border small mb-3">@Model.OrderTarget.Message</div>
                    }
                    else
                    {
                        <!-- No scanned table and no confirmed booking: explain why, and offer a booking instead -->
                        <div class="alert alert-warning small mb-3">
                            @Model.OrderTarget.Message
                            <a asp-page="/Reservations/Create" class="alert-link d-block mt-1">Book a table</a>
                        </div>
                    }

                        <form method="post" asp-page="/Orders/Checkout">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="PromoCode" class="form-label">Promo code (optional)</label>
                            <div class="input-group">
                                <input asp-for="PromoCode" class="form-control" maxlength="20"
                                       placeholder="e.g. PROMO3" autocomplete="off" />
                                <button type="submit" asp-page-handler="Apply" formnovalidate
                                        class="btn btn-outline-secondary">Apply</button>
                            </div>
                            <span asp-validation-for="PromoCode" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Notes" class="form-label"></label>
                            <textarea asp-for="Input.Notes" class="form-control" rows="3" maxlength="500"
                                      placeholder="e.g. no chilli, extra napkins"></textarea>
                            <span asp-validation-for="Input.Notes" class="text-danger"></span>
                        </div>

                        <!-- Disabled only for convenience: the service refuses the order anyway if there is no table -->
                        <button type="submit" class="btn btn-primary" disabled="@(!Model.OrderTarget.CanOrder)">Place order</button>
                        <a asp-page="./Cart" class="btn btn-secondary">Back to cart</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
