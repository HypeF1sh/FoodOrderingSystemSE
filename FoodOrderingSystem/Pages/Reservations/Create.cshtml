@page
@model FoodOrderingSystem.Pages.Reservations.CreateModel
@{
    ViewData["Title"] = "Book a Table";
}

<div class="container py-4">
    <h1 class="mb-4">Book a Table</h1>

    <!-- PB09: Check Table Availability Form -->
    <div class="card mb-4">
        <div class="card-header bg-light">
            <strong>Check Table Availability</strong>
            <span class="text-muted small ms-2">(90-minute dining slot)</span>
        </div>
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <input type="hidden" name="check" value="true" />

                <div class="col-md-3">
                    <label asp-for="Search.Date" class="form-label">Date</label>
                    <input asp-for="Search.Date" type="date" class="form-control"
                           min="@DateTime.Today.ToString("yyyy-MM-dd")"
                           max="@DateTime.Today.AddDays(60).ToString("yyyy-MM-dd")" />
                </div>

                <div class="col-md-2">
                    <label asp-for="Search.StartTime" class="form-label">Start Time</label>
                    <input asp-for="Search.StartTime" type="time" class="form-control" step="900" />
                </div>

                <div class="col-md-2">
                    <label asp-for="Search.PartySize" class="form-label">Party Size</label>
                    <input asp-for="Search.PartySize" type="number" min="1" max="20" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label asp-for="Search.DiningAreaId" class="form-label">Dining Area</label>
                    <select asp-for="Search.DiningAreaId" asp-items="Model.DiningAreaOptions" class="form-select"></select>
                </div>

                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-primary">Check Tables</button>
                </div>
            </form>
        </div>
    </div>

    <!-- PB09: Search Results -->
    @if (Model.HasSearched)
    {
        @if (!string.IsNullOrEmpty(Model.AvailabilityMessage))
        {
            <div class="alert alert-warning">@Model.AvailabilityMessage</div>
        }
        else if (Model.AvailableTables.Any())
        {
            <div class="card">
                <div class="card-header bg-light">
                    <strong>Available Tables (@Model.AvailableTables.Count found)</strong>
                    <span class="text-muted small ms-2">
                        for @Model.Search.PartySize guest(s) on @Model.Search.Date.ToString("dd MMM yyyy"),
                        @Model.Search.StartTime.ToString("HH:mm") – @Model.Search.StartTime.AddMinutes(90).ToString("HH:mm")
                    </span>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        @foreach (var table in Model.AvailableTables)
                        {
                            <div class="col-md-4">
                                <div class="card h-100 p-3">
                                    <div class="fw-bold">Table @table.TableNumber</div>
                                    <div class="text-muted small">@table.DiningAreaName</div>
                                    <div class="mt-2">
                                        <span class="badge bg-success">Seats up to @table.Capacity</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>