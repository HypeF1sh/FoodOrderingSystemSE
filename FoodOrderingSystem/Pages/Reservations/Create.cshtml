@page
@model FoodOrderingSystem.Pages.Reservations.CreateModel
@{
    ViewData["Title"] = "Book a Table";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Book a Table</h1>
        <a asp-page="Index" class="btn btn-outline-secondary">My Reservations</a>
    </div>

    <!-- Step 1: Check Table Availability (PB09) -->
    <div class="card mb-4">
        <div class="card-header bg-light">
            <strong>1. Pick a day, time and party size</strong>
            <span class="text-muted small ms-2">(90-minute dining slot)</span>
        </div>
        <div class="card-body">
            @* Tap-to-choose picker (_BookingPicker): it posts the same Search.Date / Search.StartTime / Search.PartySize
               fields as the old date, time and number boxes, so CreateModel and ReservationService are unchanged *@
            <form method="get">
                <input type="hidden" name="check" value="true" />

                <partial name="_BookingPicker" model='new FoodOrderingSystem.ViewModels.BookingPickerViewModel(Model.Search.Date, Model.Search.StartTime, Model.Search.PartySize, "Search.Date", "Search.StartTime", "Search.PartySize")' />

                <div class="bp-label mt-3">Area</div>
                <div class="bp-area" role="radiogroup" aria-label="Dining area">
                    @foreach (var option in Model.DiningAreaOptions)
                    {
                        var isOn = option.Value == (Model.Search.DiningAreaId?.ToString() ?? "");
                        <label class="bp-area-chip">
                            <input type="radio" name="Search.DiningAreaId" value="@option.Value" checked="@isOn" />
                            <span>@(option.Value == "" ? "Any area" : option.Text)</span>
                        </label>
                    }
                </div>

                <button type="submit" class="btn btn-primary mt-4 px-4">Find a table</button>
            </form>
            <div class="form-text mt-2">
                Maximum online party size is 8 guests. Planning a larger gathering? Please call us directly so we can arrange combined seating.
            </div>
        </div>
    </div>

    <!-- Step 2: Select a Table & Confirm Reservation (PB10) -->
    @if (Model.HasSearched)
    {
        @if (!string.IsNullOrEmpty(Model.AvailabilityMessage))
        {
            <div class="alert alert-warning">@Model.AvailabilityMessage</div>
        }
        else if (Model.AvailableTables.Any())
        {
            <div class="card">
                <div class="card-header bg-light">
                    <strong>2. Select a Table &amp; Confirm (@Model.AvailableTables.Count available)</strong>
                    <span class="text-muted small ms-2">
                        for @Model.Search.PartySize guest(s) on @Model.Search.Date.ToString("dd/MM/yyyy"),
                        @Model.Search.StartTime.ToString("hh:mm tt") – @Model.Search.StartTime.AddMinutes(90).ToString("hh:mm tt")
                    </span>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <input type="hidden" name="Input.Date" value="@Model.Search.Date.ToString("yyyy-MM-dd")" />
                        <input type="hidden" name="Input.StartTime" value="@Model.Search.StartTime.ToString("HH:mm")" />
                        <input type="hidden" name="Input.PartySize" value="@Model.Search.PartySize" />
                        <input type="hidden" name="Input.DiningAreaId" value="@Model.Search.DiningAreaId" />

                        <div class="row g-3 mb-3">
                            @foreach (var table in Model.AvailableTables)
                            {
                                <div class="col-md-4">
                                    <label class="card h-100 p-3" style="cursor: pointer;">
                                        <span class="form-check">
                                            <input class="form-check-input" type="radio"
                                                   name="Input.RestaurantTableId"
                                                   value="@table.RestaurantTableId"
                                                   required />
                                            <span class="form-check-label fw-bold">
                                                Table @table.TableNumber
                                            </span>
                                        </span>
                                        <span class="text-muted small ps-4">@table.DiningAreaName</span>
                                        <span class="mt-2 ps-4">
                                            <span class="badge bg-success">Seats up to @table.Capacity</span>
                                        </span>
                                    </label>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="Input.RestaurantTableId" class="text-danger d-block mb-3"></span>

                        <div class="mb-3">
                            <label asp-for="Input.SpecialRequests" class="form-label">Special Requests (Optional)</label>
                            <textarea asp-for="Input.SpecialRequests" class="form-control" rows="2"
                                      placeholder="e.g., Baby chair needed, window seat, dietary notes..."></textarea>
                            <span asp-validation-for="Input.SpecialRequests" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary">Submit Reservation Request</button>
                    </form>
                </div>
            </div>
        }
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}