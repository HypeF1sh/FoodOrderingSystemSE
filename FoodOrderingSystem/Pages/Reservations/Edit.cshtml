@page "{id:int}"
@model FoodOrderingSystem.Pages.Reservations.EditModel
@{
    ViewData["Title"] = "Modify Reservation";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Modify Reservation #@Model.Input.ReservationId</h1>
        <a asp-page="Index" class="btn btn-outline-secondary">Back to My Reservations</a>
    </div>

    <div class="row">
        <div class="col-md-7">
            <!-- Step 1: Check New Slot Availability (GET) -->
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <strong>1. Date, Time &amp; Party Size</strong>
                    <span class="text-muted small ms-2">(Click "Update Available Tables" if you change these)</span>
                </div>
                <div class="card-body">
                    <form method="get" class="row g-3 align-items-end">
                        @* Tap-to-choose picker; posts the same date / startTime / partySize fields as before *@
                        <div class="col-12">
                            <partial name="_BookingPicker" model='new FoodOrderingSystem.ViewModels.BookingPickerViewModel(Model.Input.Date, Model.Input.StartTime, Model.Input.PartySize, "date", "startTime", "partySize")' />
                        </div>

                        <div class="col-12">
                            <button type="submit" class="btn btn-sm btn-outline-primary">
                                Update Available Tables for This Slot
                            </button>
                            <div class="form-text mt-1">
                                Maximum online party size is 8 guests. Please call us directly for larger groups.
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Step 2: Confirm Table & Save Changes (POST) -->
            <div class="card">
                <div class="card-header bg-light">
                    <strong>2. Confirm Table &amp; Save Changes</strong>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.AvailabilityWarning))
                    {
                        <div class="alert alert-warning">@Model.AvailabilityWarning</div>
                    }

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <input type="hidden" asp-for="Input.ReservationId" />
                        <input type="hidden" asp-for="Input.Date" value="@Model.Input.Date.ToString("yyyy-MM-dd")" />
                        <input type="hidden" asp-for="Input.StartTime" value="@Model.Input.StartTime.ToString("HH:mm")" />
                        <input type="hidden" asp-for="Input.PartySize" />

                        <div class="mb-3">
                            <label class="form-label text-muted small">Selected Slot</label>
                            <div class="fw-bold">
                                @Model.Input.Date.ToString("dd/MM/yyyy"),
                                @Model.Input.StartTime.ToString("hh:mm tt") – @Model.Input.StartTime.AddMinutes(90).ToString("hh:mm tt")
                                (@Model.Input.PartySize guest(s))
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.RestaurantTableId" class="form-label">Available Table</label>
                            <select asp-for="Input.RestaurantTableId" asp-items="Model.TableOptions" class="form-select"></select>
                            <span asp-validation-for="Input.RestaurantTableId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.SpecialRequests" class="form-label">Special Requests (Optional)</label>
                            <textarea asp-for="Input.SpecialRequests" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="Input.SpecialRequests" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary" @(Model.TableOptions.Count == 0 ? "disabled" : "")>
                            Save Changes
                        </button>
                        <a asp-page="Index" class="btn btn-outline-secondary ms-1">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}