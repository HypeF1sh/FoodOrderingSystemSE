@page
@model FoodOrderingSystem.Pages.Menu.IndexModel
@{
    ViewData["Title"] = "Menu";
    var menu = Model.Menu;
    var isSearching = !string.IsNullOrEmpty(menu.Search);
    var returnUrl = Request.Path + Request.QueryString;
}

@await Component.InvokeAsync("OffersStrip")

<div class="container mt-4">

    <!-- Heading + search. A GET form, so the filter shows in the URL and works without JavaScript -->
    <div class="menu-header">
        <h1 class="mb-0">Our Menu</h1>
        <form method="get" asp-page="./Index" class="menu-search" role="search">
            @if (menu.SelectedCategoryId.HasValue)
            {
                <input type="hidden" name="categoryId" value="@menu.SelectedCategoryId" />
            }
            <label for="menuSearch" class="visually-hidden">Search dishes</label>
            <div class="input-group">
                <input id="menuSearch" type="search" name="search" value="@menu.Search"
                       class="form-control" placeholder="Search dishes…" maxlength="100" />
                <button type="submit" class="btn btn-primary">Search</button>
            </div>
        </form>
    </div>

    <!-- Category tabs: sticky, and scroll sideways on a phone so every category stays one tap away -->
    <nav class="menu-tabs" aria-label="Menu categories">
        <a asp-page="./Index" asp-route-search="@menu.Search"
           class="menu-tab @(menu.SelectedCategoryId == null ? "active" : "")"
           aria-current="@(menu.SelectedCategoryId == null ? "page" : null)">All</a>
        @foreach (var tab in menu.Tabs)
        {
            var isActive = tab.MenuCategoryId == menu.SelectedCategoryId;
            <a asp-page="./Index" asp-route-categoryId="@tab.MenuCategoryId" asp-route-search="@menu.Search"
               class="menu-tab @(isActive ? "active" : "")"
               aria-current="@(isActive ? "page" : null)">@tab.Name</a>
        }
    </nav>

    @if (menu.Sections.Count == 0)
    {
        <!-- Empty state: either the search found nothing, or there are no dishes yet -->
        <div class="menu-empty">
            @if (isSearching)
            {
                <p class="mb-2">No dishes match “@menu.Search”.</p>
                <a asp-page="./Index" asp-route-categoryId="@menu.SelectedCategoryId" class="btn btn-secondary">Clear search</a>
            }
            else
            {
                <p class="mb-0">No dishes here yet — please check back soon.</p>
            }
        </div>
    }

    @foreach (var category in menu.Sections)
    {
        <section class="menu-section" aria-labelledby="cat-@category.MenuCategoryId">
            <h2 id="cat-@category.MenuCategoryId" class="menu-section-title">@category.Name</h2>
            @if (!string.IsNullOrEmpty(category.Description))
            {
                <p class="text-muted menu-section-desc">@category.Description</p>
            }

            <div class="menu-grid">
                @foreach (var item in category.Items)
                {
                    <article class="menu-card @(item.IsAvailable ? "" : "is-sold-out")">
                        <img src="@item.ImageUrl" alt="" class="menu-card-img" loading="lazy" />
                        <div class="menu-card-body">
                            <div class="menu-card-head">
                                <h3 class="menu-card-name">@item.Name</h3>
                                <span class="menu-card-price">RM @item.Price.ToString("0.00")</span>
                            </div>
                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <p class="menu-card-desc">@item.Description</p>
                            }
                            @if (!item.IsAvailable)
                            {
                                <span class="badge bg-secondary">Sold out</span>
                            }
                            else
                            {
                                <!-- PB14: posts to the cart, then comes back to this same tab/search.
                                     UX1: menu-cart.js catches the submit and asks for the quantity first. -->
                                <form method="post" asp-page="/Orders/Cart" asp-page-handler="Add" class="menu-card-add"
                                      data-dish-name="@item.Name" data-dish-price="@item.Price.ToString("0.00")">
                                    <input type="hidden" name="menuItemId" value="@item.MenuItemId" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="btn btn-sm btn-primary">Add</button>
                                </form>
                            }
                        </div>
                    </article>
                }
            </div>
        </section>
    }
</div>

<!-- Sticky bar so the cart is always one tap away on a phone.
     Always rendered (hidden while empty) so menu-cart.js can show it after the first dish is added. -->
<div id="menuCartBar" class="menu-cart-bar @(Model.CartCount > 0 ? "" : "d-none")">
    <a asp-page="/Orders/Cart" class="btn btn-primary w-100">View cart (<span id="menuCartCount">@Model.CartCount</span>)</a>
</div>

<!-- UX1: quick confirm with a quantity, so one mis-tap does not add a dish -->
<div class="modal fade" id="addToCartModal" tabindex="-1" aria-labelledby="addToCartTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="addToCartTitle">Add to cart</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-1 fw-semibold" id="addToCartName"></p>
                <p class="text-muted mb-3">RM <span id="addToCartPrice"></span> each</p>
                <div class="qty-stepper" role="group" aria-label="Quantity">
                    <button type="button" class="btn btn-outline-secondary" id="qtyMinus" aria-label="One less">−</button>
                    <output id="qtyValue" class="qty-value" aria-live="polite">1</output>
                    <button type="button" class="btn btn-outline-secondary" id="qtyPlus" aria-label="One more">+</button>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="addToCartConfirm">Add · RM <span id="addToCartTotal"></span></button>
            </div>
        </div>
    </div>
</div>

<!-- UX1: floating notification after adding (menu page only, so the shared _Banners stays as it is) -->
<div class="toast-container position-fixed start-50 translate-middle-x menu-toast-area">
    <div id="menuToast" class="toast menu-toast" role="status" aria-live="polite" aria-atomic="true" data-bs-delay="2500">
        <div class="d-flex">
            <div class="toast-body" id="menuToastText"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/menu-cart.js" asp-append-version="true"
            data-max-qty="@FoodOrderingSystem.Services.CartService.MaxQuantityPerLine"></script>
}
