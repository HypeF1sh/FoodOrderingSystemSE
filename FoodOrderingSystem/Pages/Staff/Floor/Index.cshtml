@page
@using Microsoft.AspNetCore.Identity
@using FoodOrderingSystem.Models
@using FoodOrderingSystem.ViewModels
@inject UserManager<ApplicationUser> UserManager
@model FoodOrderingSystem.Pages.Staff.Floor.IndexModel
@{
    ViewData["Title"] = "Tonight";
    var floor = Model.Floor;
    var selected = floor.SelectedTable;

    // Greeting with the first name, read the same way the Today page does
    var user = await UserManager.GetUserAsync(User);
    var firstName = string.IsNullOrWhiteSpace(user?.FullName) ? null : user.FullName.Split(' ')[0];
    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "Good morning" : hour < 18 ? "Good afternoon" : "Good evening";
}

@*
    Tonight: the staff home. A to-do list of everything that needs staff (each with the one button that
    finishes it) beside the table map. Tapping a table slides in its panel: guests, orders, bill, Take payment.
*@
<div class="container mt-4 fl">
    <div class="tn-head">
        <h1>@greeting@(firstName == null ? "" : ", " + firstName)</h1>
        <p>Everything that needs you, most urgent first. Tap the button to finish it, or a table to see its orders and bill.</p>
    </div>

    @if (floor.Areas.Count == 0)
    {
        <div class="alert alert-light border">No tables set up yet. Ask an admin to add dining areas and tables.</div>
    }
    else
    {
        <div class="fl-layout">
            <div class="fl-live"
                 data-live-url="@Url.Page("./Index", "Grid", new { areaId = floor.SelectedAreaId, table = floor.SelectedTableId })">
                <partial name="_FloorGrid" model="floor" />
            </div>

            @* Table panel: slides in from the right on every screen size (a bottom sheet on phones), so the
               to-do list and the map keep the full width until a table is tapped *@
            <aside id="tableDrawer" class="fl-drawer tn-drawer offcanvas offcanvas-end" tabindex="-1"
                   aria-labelledby="tableDrawerTitle" data-open="@(selected != null ? "true" : "false")"
                   data-close-url="@Url.Page("./Index", new { areaId = floor.SelectedAreaId })">
                @if (selected != null)
                {
                    <partial name="/Pages/Staff/_TablePanel.cshtml" model="new TablePanelViewModel(selected, floor.SelectedAreaId)" />
                }
            </aside>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/staff-live.js" asp-append-version="true"></script>
    <script>
        // The table panel is a slide-in, so open it when a table was chosen (?table=...).
        // Closing it goes back to Tonight without the table, so a refresh doesn't pop it open again.
        (function () {
            const drawer = document.getElementById('tableDrawer');
            if (drawer && drawer.dataset.open === 'true') {
                bootstrap.Offcanvas.getOrCreateInstance(drawer).show();
                drawer.addEventListener('hidden.bs.offcanvas', function () {
                    window.location.href = drawer.dataset.closeUrl;
                });
            }
        })();
    </script>
}
