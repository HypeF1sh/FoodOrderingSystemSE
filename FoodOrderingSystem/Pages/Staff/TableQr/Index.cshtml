@page
@model FoodOrderingSystem.Pages.Staff.TableQr.IndexModel
@{
    ViewData["Title"] = "Table QR codes";
}

<div class="container mt-4">
    @* Shared back office header (bo-head) *@
    <div class="bo-head tq-no-print">
        <div>
            <h1>Table QR codes</h1>
            <p class="bo-head-sub">Print this page and stick each code on its table. Scanning a code opens the menu
                with that table attached, so the order goes straight to it.</p>
        </div>
        <button type="button" class="btn btn-primary" onclick="window.print()">Print</button>
    </div>

    @if (Model.Codes.Count == 0)
    {
        <partial name="_EmptyState" model='new FoodOrderingSystem.ViewModels.EmptyStateViewModel("No tables yet", "An administrator adds tables under Configurations, then their QR codes appear here.", "table")' />
    }
    else
    {
        <div class="tq-grid">
            @foreach (var code in Model.Codes)
            {
                <div class="card shadow-sm tq-card">
                    <div class="card-body text-center">
                        <div class="fw-semibold fs-4">@code.TableNumber</div>
                        <div class="text-muted small mb-2">@code.DiningAreaName</div>
                        <img src="@code.ImageDataUri" alt="QR code for table @code.TableNumber" class="tq-img" />
                        <div class="small mt-2">Scan to order</div>
                        <!-- The link as text, so it can be tested on a PC without a phone -->
                        <a href="@code.Link" class="tq-link small text-break tq-no-print">Open link</a>
                    </div>
                </div>
            }
        </div>
    }
</div>
