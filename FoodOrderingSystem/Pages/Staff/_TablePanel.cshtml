@using FoodOrderingSystem.ViewModels
@model TablePanelViewModel
@*
    Table panel: who is at the table, every order with dishes and prices, the table total and the one
    next-step button (Take payment, Mark served, Complete table...). Used by Tonight (slide-in) and Tables (side
    panel). Forms post to the current page's handlers - both pages have Confirm, Serve, SendToKitchen and Complete.
*@
@{
    var table = Model.Table;
}
<div class="fl-drawer-body">
<div class="fl-drawer-head">
    <h2 id="tableDrawerTitle" class="fl-drawer-title">Table @table.TableNumber</h2>
    <a asp-page="./Index" asp-route-areaId="@Model.AreaId" class="btn-close" aria-label="Close table"></a>
</div>
<span class="fl-state is-@TableStateDisplay.CssName(table.State)">@TableStateDisplay.Label(table.State)</span>

@if (table.ReservationId != null)
{
    <p class="fl-who">
        @table.CustomerName · party of @table.PartySize<br />
        <span class="fl-muted">
            @(table.StartTime?.ToString("h:mm tt"))–@(table.EndTime?.ToString("h:mm tt")) · Ref #@table.ReservationId
        </span>
    </p>
}
else
{
    <p class="fl-muted">@table.Capacity seats · no booking right now</p>
}

@foreach (var order in table.Orders)
{
    <div class="fl-order">
        <div class="fl-row">
            <span class="fw-semibold">Order #@order.OrderId</span>
            <partial name="/Pages/Orders/_OrderStatusBadge.cshtml" model="order.Status" />
        </div>
        @if (!string.IsNullOrEmpty(order.Notes))
        {
            <div class="fl-note">⚠ @order.Notes</div>
        }
        <ul class="fl-lines">
            @foreach (var line in order.Lines)
            {
                <li><span>@line.Quantity× @line.Name</span><span>@((line.Quantity * line.UnitPrice).ToString("0.00"))</span></li>
            }
        </ul>
        <div class="fl-row">
            <span class="fw-semibold">RM @order.TotalAmount.ToString("0.00")</span>
            <partial name="/Pages/Payments/_PaymentStatusBadge.cshtml" model="order.PaymentStatus" />
        </div>
        @* Any unpaid order can be opened on the Bill page, e.g. a guest paying before the food comes *@
        @if (!order.IsPaid && order.OrderId != table.ActionOrderId)
        {
            <a asp-page="/Staff/Billing/Bill" asp-route-id="@order.OrderId" class="tn-bill-link">Open bill for #@order.OrderId →</a>
        }
    </div>
}

@if (table.Orders.Count > 1)
{
    <div class="fl-row tn-total">
        <span>Table total</span>
        <span>RM @table.Orders.Sum(o => o.TotalAmount).ToString("0.00")</span>
    </div>
}

@foreach (var order in table.HeldOrders)
{
    <div class="fl-order">
        <div class="fl-row">
            <span class="fw-semibold">Pre-order #@order.OrderId</span>
            <partial name="/Pages/Orders/_OrderStatusBadge.cshtml" model="order.Status" />
        </div>
        @if (!string.IsNullOrEmpty(order.Notes))
        {
            <div class="fl-note">⚠ @order.Notes</div>
        }
        <ul class="fl-lines">
            @foreach (var line in order.Lines)
            {
                <li><span>@line.Quantity× @line.Name</span><span>@((line.Quantity * line.UnitPrice).ToString("0.00"))</span></li>
            }
        </ul>
        <p class="fl-muted mb-2">Check the customer has arrived, then send it to the kitchen.</p>
        <form method="post" asp-page-handler="SendToKitchen" asp-route-orderId="@order.OrderId"
              asp-route-areaId="@Model.AreaId" asp-route-table="@table.RestaurantTableId">
            <button type="submit" class="btn btn-primary fl-action">Send #@order.OrderId to kitchen</button>
        </form>
    </div>
}

@switch (table.Action)
{
    case TableAction.ConfirmBooking:
        <form method="post" asp-page-handler="Confirm" asp-route-reservationId="@table.ReservationId"
              asp-route-areaId="@Model.AreaId" asp-route-table="@table.RestaurantTableId">
            <button type="submit" class="btn btn-primary fl-action">Confirm booking</button>
        </form>
        break;
    case TableAction.MarkServed:
        <form method="post" asp-page-handler="Serve" asp-route-orderId="@table.ActionOrderId"
              asp-route-areaId="@Model.AreaId" asp-route-table="@table.RestaurantTableId">
            <button type="submit" class="btn btn-primary fl-action">Mark #@table.ActionOrderId served</button>
        </form>
        break;
    case TableAction.CompleteTable:
        <form method="post" asp-page-handler="Complete" asp-route-reservationId="@table.ReservationId"
              asp-route-areaId="@Model.AreaId" asp-route-table="@table.RestaurantTableId">
            <button type="submit" class="btn btn-primary fl-action">Complete table</button>
        </form>
        break;
    case TableAction.TakePayment:
        <a asp-page="/Staff/Billing/Bill" asp-route-id="@table.ActionOrderId" class="btn btn-primary fl-action">
            Take payment · RM @table.UnpaidTotal.ToString("0.00") →
        </a>
        break;
    case TableAction.ViewInPass:
        <a asp-page="/Staff/Orders/Index" class="btn btn-outline-primary fl-action">View in The Pass</a>
        break;
}

@if (table.LaterToday.Count > 0)
{
    <h3 class="fl-sub">Later today</h3>
    <ul class="fl-later">
        @foreach (var booking in table.LaterToday)
        {
            <li>@booking</li>
        }
    </ul>
}
</div>
