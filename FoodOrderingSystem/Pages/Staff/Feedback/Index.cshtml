@page
@model FoodOrderingSystem.Pages.Staff.Feedback.IndexModel
@{
    ViewData["Title"] = "Reviews";
    double avgRating = Model.Feedbacks.Any() ? Model.Feedbacks.Average(f => f.Rating) : 0;
}

<div class="container py-4">
    @* Shared back office header (bo-head): title, what is on screen, and stat tiles *@
    <div class="bo-head">
        <div>
            <h1>Reviews</h1>
            <p class="bo-head-sub">What guests said after their meal</p>
        </div>
        <div class="bo-stats">
            <div class="bo-stat is-amber"><strong>@avgRating.ToString("0.0") ★</strong><span>Average rating</span></div>
            <div class="bo-stat"><strong>@Model.Feedbacks.Count</strong><span>Reviews shown</span></div>
        </div>
    </div>

    <div class="bo-filters">
        <div>
            <form method="get" class="row g-2 align-items-end">
                <div class="col-sm-4">
                    <label class="form-label">Rating</label>
                    <select asp-for="RatingFilter" class="form-select">
                        <option value="">All ratings</option>
                        <option value="5">5 stars</option>
                        <option value="4">4 stars</option>
                        <option value="3">3 stars</option>
                        <option value="2">2 stars</option>
                        <option value="1">1 star</option>
                    </select>
                </div>
                <div class="col-sm-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Filter</button>
                    <a asp-page="Index" class="btn btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Feedbacks.Any())
    {
        <partial name="_EmptyState" model='new FoodOrderingSystem.ViewModels.EmptyStateViewModel("No reviews yet", "Guests can rate their meal after paying. New reviews will show up here.", "star")' />
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Customer</th>
                        <th>Visit Ref</th>
                        <th>Rating</th>
                        <th>Comment</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Feedbacks)
                    {
                        <tr>
                            <td>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy hh:mm tt")</td>
                            <td>
                                <div class="fw-semibold">@item.CustomerName</div>
                                <div class="text-muted small">@item.CustomerEmail</div>
                            </td>
                            <td>
                                @if (item.ReservationId.HasValue)
                                {
                                    <span class="badge bg-light text-dark border">Reservation #@item.ReservationId</span>
                                }
                                @if (item.OrderId.HasValue)
                                {
                                    <span class="badge bg-light text-dark border">Order #@item.OrderId</span>
                                }
                            </td>
                            <td class="text-warning fw-bold text-nowrap">
                                @(new string('★', item.Rating))@(new string('☆', 5 - item.Rating))
                                <span class="text-dark small">(@item.Rating)</span>
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(item.Comment) ? "-" : item.Comment)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>