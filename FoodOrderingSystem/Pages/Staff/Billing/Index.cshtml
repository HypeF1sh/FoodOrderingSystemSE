@page
@model FoodOrderingSystem.Pages.Staff.Billing.IndexModel
@{
    ViewData["Title"] = "Billing";
}

<div class="container py-4">
    @* Shared back office header (bo-head): title, what is on screen, and stat tiles *@
    <div class="bo-head">
        <div>
            <h1>Billing</h1>
            <p class="bo-head-sub">Unpaid orders for @Model.EffectiveDate.ToString("dddd, d MMMM yyyy")</p>
        </div>
        <div class="bo-stats">
            <div class="bo-stat is-amber"><strong>@Model.UnpaidOrders.Count</strong><span>Unpaid orders</span></div>
            <div class="bo-stat is-plum"><strong>RM @Model.UnpaidOrders.Sum(o => o.TotalAmount).ToString("0.00")</strong><span>Still to collect</span></div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <!-- Filter Unpaid Orders by Date -->
        <div class="col-md-7">
            <div class="bo-filters h-100 mb-0">
                <div>
                    <form method="get" class="row g-2 align-items-end">
                        <div class="col-sm-6">
                            <label class="form-label">Date</label>
                            <input type="date" name="FilterDate" value="@Model.EffectiveDate.ToString("yyyy-MM-dd")" class="form-control" />
                        </div>
                        <div class="col-sm-6 d-flex gap-2">
                            <button type="submit" class="btn btn-primary flex-grow-1">Show</button>
                            <a asp-page="Index" class="btn btn-outline-secondary">Today</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Quick Order / Bill Lookup (For Paid Orders or Refunds) -->
        <div class="col-md-5">
            <div class="bo-filters h-100 mb-0">
                <div>
                    <form method="post" asp-page-handler="LookupOrder" class="row g-2 align-items-end">
                        <div class="col-sm-7">
                            <label class="form-label">Find a bill by order #</label>
                            <input type="number" name="orderId" min="1" class="form-control" placeholder="e.g. 101 (pay or refund)" required />
                        </div>
                        <div class="col-sm-5 d-grid">
                            <button type="submit" class="btn btn-outline-dark">Open bill</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (!Model.UnpaidOrders.Any())
    {
        <partial name="_EmptyState" model='new FoodOrderingSystem.ViewModels.EmptyStateViewModel("All bills are settled", $"No unpaid orders for {Model.EffectiveDate:d MMMM}. To view or refund a paid order, find it by order number above.", "receipt")' />
    }
    else
    {
        <!-- Desktop Table -->
        <div class="table-responsive d-none d-md-block">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Time Placed</th>
                        <th>Customer</th>
                        <th>Reservation</th>
                        <th>Kitchen Status</th>
                        <th>Online Attempt</th>
                        <th class="text-end">Total Amount</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var order in Model.UnpaidOrders)
                {
                    <tr>
                        <td><strong>#@order.OrderId</strong></td>
                        <td>@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy hh:mm tt")</td>
                        <td>@order.CustomerName</td>
                        <td>
                            @if (order.ReservationId.HasValue)
                            {
                                <span class="badge bg-light text-dark border">Booking #@order.ReservationId</span>
                            }
                            else
                            {
                                <span class="text-muted small">Walk-in / Direct</span>
                            }
                        </td>
                        <td><span class="badge bg-secondary">@order.OrderStatus</span></td>
                        <td>
                            @if (order.HasFailedAttempt)
                            {
                                <span class="badge bg-danger">Declined Online</span>
                            }
                            else
                            {
                                <span class="text-muted small">None</span>
                            }
                        </td>
                        <td class="text-end fw-bold">RM @order.TotalAmount.ToString("0.00")</td>
                        <td class="text-end">
                            <a asp-page="Bill" asp-route-id="@order.OrderId" class="btn btn-sm btn-primary">
                                Open Bill &amp; Pay
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <!-- Phone Layout -->
        <div class="d-md-none d-flex flex-column gap-3">
            @foreach (var order in Model.UnpaidOrders)
            {
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center bg-light">
                        <strong>Order #@order.OrderId — @order.CustomerName</strong>
                        <span class="badge bg-secondary">@order.OrderStatus</span>
                    </div>
                    <div class="card-body">
                        <div class="mb-1"><strong>Time:</strong> @order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy hh:mm tt")</div>
                        <div class="mb-1"><strong>Total:</strong> <span class="fw-bold">RM @order.TotalAmount.ToString("0.00")</span></div>
                        @if (order.HasFailedAttempt)
                        {
                            <div class="mt-1"><span class="badge bg-danger">Previous Online Attempt Declined</span></div>
                        }
                    </div>
                    <div class="card-footer bg-white text-end">
                        <a asp-page="Bill" asp-route-id="@order.OrderId" class="btn btn-sm btn-primary">Open Bill &amp; Pay</a>
                    </div>
                </div>
            }
        </div>
    }
</div>