  <diagram name="Page-1" id="wPyeKKkABlMd_ZzBewzz">
    <mxGraphModel dx="2146" dy="1098" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    %% ==========================================\n    %% DOMAIN A: ACCOUNTS &amp; ADMINISTRATION\n    %% ==========================================\n    User {\n        string UserId PK\n        string FullName\n        string Email\n        string PhoneNumber\n        string Role\n        bool IsActive\n        datetime CreatedAt\n    }\n\n    DiningArea {\n        int DiningAreaId PK\n        string Name\n        string Description\n    }\n\n    RestaurantTable {\n        int RestaurantTableId PK\n        int DiningAreaId FK\n        string TableNumber\n        int Capacity\n        bool IsActive\n    }\n\n    OperatingHours {\n        int OperatingHoursId PK\n        int DayOfWeek\n        time OpenTime\n        time CloseTime\n        bool IsClosed\n    }\n\n    Promotion {\n        int PromotionId PK\n        string Title\n        string Description\n        decimal DiscountPercent\n        datetime StartDate\n        datetime EndDate\n        bool IsActive\n    }\n\n    Announcement {\n        int AnnouncementId PK\n        string Title\n        string Body\n        datetime PublishedAt\n        bool IsActive\n    }\n\n    RestaurantSetting {\n        int RestaurantSettingId PK\n        string Key\n        string Value\n    }\n\n    %% ==========================================\n    %% DOMAIN B: RESERVATIONS &amp; OPERATIONS\n    %% ==========================================\n    Reservation {\n        int ReservationId PK\n        string CustomerId FK\n        int RestaurantTableId FK\n        date ReservationDate\n        time StartTime\n        time EndTime\n        int PartySize\n        string Status\n        string SpecialRequests\n        datetime CreatedAt\n    }\n\n    Feedback {\n        int FeedbackId PK\n        string CustomerId FK\n        int ReservationId FK \&quot;Nullable\&quot;\n        int OrderId FK \&quot;Nullable\&quot;\n        int Rating\n        string Comment\n        datetime CreatedAt\n    }\n\n    Notification {\n        int NotificationId PK\n        string UserId FK\n        string Type\n        string Message\n        bool IsRead\n        datetime CreatedAt\n    }\n\n    %% ==========================================\n    %% DOMAIN C: MENU, ORDERS &amp; PAYMENT\n    %% ==========================================\n    MenuCategory {\n        int MenuCategoryId PK\n        string Name\n        string Description\n        int DisplayOrder\n        bool IsActive\n    }\n\n    MenuItem {\n        int MenuItemId PK\n        int MenuCategoryId FK\n        string Name\n        string Description\n        decimal Price\n        string ImageUrl\n        bool IsAvailable\n    }\n\n    Order {\n        int OrderId PK\n        string CustomerId FK\n        int ReservationId FK \&quot;Nullable\&quot;\n        string Status\n        decimal TotalAmount\n        string Notes\n        datetime CreatedAt\n    }\n\n    OrderItem {\n        int OrderItemId PK\n        int OrderId FK\n        int MenuItemId FK\n        int Quantity\n        decimal UnitPrice\n    }\n\n    Payment {\n        int PaymentId PK\n        int OrderId FK\n        string RecordedByUserId FK \&quot;Nullable\&quot;\n        decimal Amount\n        string Method\n        string Status\n        string TransactionRef\n        datetime PaidAt\n    }\n\n    %% ==========================================\n    %% RELATIONSHIPS (CROW&#39;S FOOT NOTATION)\n    %% ==========================================\n    DiningArea ||--o{ RestaurantTable : \&quot;contains\&quot;\n    RestaurantTable ||--o{ Reservation : \&quot;booked_for\&quot;\n\n    User ||--o{ Reservation : \&quot;places\&quot;\n    User ||--o{ Order : \&quot;submits\&quot;\n    User ||--o{ Feedback : \&quot;writes\&quot;\n    User ||--o{ Notification : \&quot;receives\&quot;\n    User ||--o{ Payment : \&quot;recorded_by\&quot;\n\n    Reservation ||--o{ Order : \&quot;links_to\&quot;\n    Reservation ||--o| Feedback : \&quot;reviewed_in\&quot;\n\n    MenuCategory ||--o{ MenuItem : \&quot;categorises\&quot;\n    MenuItem ||--o{ OrderItem : \&quot;included_in\&quot;\n\n    Order ||--o{ OrderItem : \&quot;contains\&quot;\n    Order ||--o{ Payment : \&quot;settled_via\&quot;\n    Order ||--o| Feedback : \&quot;rated_in\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="919BSNz42LfID-3555Uu-828">
